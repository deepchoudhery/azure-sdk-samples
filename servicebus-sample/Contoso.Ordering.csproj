<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Microsoft.ServiceBus.dll only ships a net462 asset, so this app cannot be built on
      .NET Core until it is migrated to Azure.Messaging.ServiceBus.
    -->
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Contoso.Ordering</RootNamespace>
    <AssemblyName>Contoso.Ordering</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>$(NoWarn);NU1902;NU1903;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindowsAzure.ServiceBus" Version="6.2.1" />
  </ItemGroup>

</Project>
