<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Contoso.Documents</RootNamespace>
    <AssemblyName>Contoso.Documents</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The whole point of this sample is that it references a deprecated package. -->
    <NoWarn>$(NoWarn);NU1902;NU1903;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindowsAzure.Storage" Version="9.3.3" />
  </ItemGroup>

</Project>
