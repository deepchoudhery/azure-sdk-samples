<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Contoso.Secrets</RootNamespace>
    <AssemblyName>Contoso.Secrets</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.9.1" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" Version="4.10.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
  </ItemGroup>

</Project>
